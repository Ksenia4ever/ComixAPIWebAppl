<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Comix Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrapOrange.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <div class="logo">Comix Store</div>

            <nav class="top-links">
                <a asp-controller="Home" asp-action="Index">Головна</a>
                <a asp-controller="Home" asp-action="Genres">Жанри</a>
                <a asp-controller="Home" asp-action="Publishers">Видавництва</a>
                <a asp-controller="Home" asp-action="Comics">Комікси</a>
                <a asp-controller="Home" asp-action="Login">Увійти</a>
                <a asp-controller="Home" asp-action="Register">Реєстрація</a>
            </nav>
        </div>
    </header>

    <main class="container page-content">
        @RenderBody()
    </main>
</body>
</html>