@{
    ViewData["Title"] = "Реєстрація";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-label">РЕЄСТРАЦІЯ</div>
        <h2 class="auth-title">Створення акаунта</h2>
        <p class="auth-subtitle">Заповніть форму, щоб створити новий обліковий запис у системі.</p>

        <form asp-controller="Home" asp-action="Comics" method="get" class="auth-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="register-name">Ім’я</label>
                    <input type="text" id="register-name" placeholder="Ваше ім’я" />
                </div>

                <div class="form-group">
                    <label for="register-email">Email</label>
                    <input type="email" id="register-email" placeholder="example@email.com" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="register-password">Пароль</label>
                    <input type="password" id="register-password" placeholder="Введіть пароль" />
                </div>

                <div class="form-group">
                    <label for="register-password-repeat">Повторіть пароль</label>
                    <input type="password" id="register-password-repeat" placeholder="Повторіть пароль" />
                </div>
            </div>

            <button type="submit" class="primary-btn">Зареєструватися</button>
        </form>

        <div class="auth-footer">
            Уже є акаунт?
            <a asp-controller="Home" asp-action="Login">Увійти</a>
        </div>
    </div>
</div>